<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Selenium Cucumber Automation Exercise TestNG Suite" parallel="tests" thread-count="2">

    <parameter name="env" value="stag"/>
    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="false"/>

    <test name="UI Regression Tests">
        <classes>
            <class name="org.example.runners.RunCucumberTest"/>
        </classes>
    </test>

</suite>